# ===== n8n =====
N8N_HOST=localhost
N8N_PROTOCOL=http
# URL pública que a AvisaAPI vai chamar (ngrok/cloudflared em dev, domínio em produção)
WEBHOOK_URL=http://localhost:5678/
# Chave de criptografia das credenciais do n8n (gere uma vez e guarde)
N8N_ENCRYPTION_KEY=troque-por-uma-chave-aleatoria-longa
GENERIC_TIMEZONE=America/Sao_Paulo

# Banco interno do n8n
N8N_DB_NAME=n8n
N8N_DB_USER=n8n
N8N_DB_PASSWORD=troque-esta-senha

# ===== Supabase (backend PetFlow) =====
SUPABASE_URL=https://jnmtwalmfkcxixiwqbjm.supabase.co
SUPABASE_SERVICE_KEY=coloque-a-service-role-key
# Chave usada pelas Edge Functions do PetFlow
PETFLOW_API_KEY=3bb9f0d2-6e9e-4bb0-bed4-2bd88894adb3

# ===== AvisaAPI (WhatsApp) =====
# Painel: https://www.avisaapi.com.br
AVISA_API_KEY=coloque-sua-api-key
